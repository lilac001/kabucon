{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wrangler: Pages dev",
      "type": "shell",
      "command": "npx",
      "args": [
        "wrangler",
        "pages",
        "dev",
        ".",
        "--port",
        "8788",
        "--inspector-port",
        "9229"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "wrangler",
        "pattern": [
          {
            "regexp": ".*"
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting local server",
          "endsPattern": "Ready on http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "wrangler"
      }
    }
  ]
}
